# ── Alpha Vantage ─────────────────────────────────────────────────────────────
# Cobre & Alumínio spot histórico (collectors/comex.py)
# Chave gratuita (25 req/dia): https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ── Nasdaq Data Link ──────────────────────────────────────────────────────────
# CFTC Managed Money (collectors/cftc.py)
# Chave gratuita: https://data.nasdaq.com/sign-up
NASDAQ_API_KEY=

# ── EIA (Energy Information Administration) ───────────────────────────────────
# Brent Crude histórico (collectors/energy_pvc.py)
# Chave gratuita: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# ── FRED (Federal Reserve Bank of St. Louis) ──────────────────────────────────
# CNY/USD, DXY, US Treasury 10Y (collectors/fx_rates.py)
# Chave gratuita: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── Configurações Gerais ───────────────────────────────────────────────────────
TIMEZONE=America/Sao_Paulo
