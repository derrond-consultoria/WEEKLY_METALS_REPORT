# ── APIs ──────────────────────────────────────────────────────────────────────

# Alpha Vantage (commodities / forex)
ALPHA_VANTAGE_API_KEY=

# Quandl / Nasdaq Data Link
NASDAQ_DATA_LINK_API_KEY=

# Trading Economics
TRADING_ECONOMICS_API_KEY=

# LME (London Metal Exchange) data feed
LME_API_KEY=

# World Bank / IMF (normalmente sem chave, mas reserve espaço)
WORLD_BANK_API_KEY=

# ── Web Scraping ───────────────────────────────────────────────────────────────

# Proxy rotation (ex: ScraperAPI, Bright Data)
SCRAPER_API_KEY=
PROXY_URL=

# ── Banco de Dados ─────────────────────────────────────────────────────────────

# PostgreSQL (armazenamento histórico)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=metals_report
DB_USER=
DB_PASSWORD=

# ── Notificações / Entrega do Relatório ────────────────────────────────────────

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Slack webhook (opcional)
SLACK_WEBHOOK_URL=

# ── Configurações Gerais ───────────────────────────────────────────────────────

# Ambiente: development | production
APP_ENV=development

# Fuso horário para agendamento
TIMEZONE=America/Sao_Paulo
